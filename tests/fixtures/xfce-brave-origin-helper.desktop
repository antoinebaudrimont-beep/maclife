[Desktop Entry]
Version=1.0
Type=X-XFCE-Helper
Name=Brave Origin Custom
Name[fr]=Brave Origin personnalisé
X-XFCE-Category=WebBrowser
X-XFCE-Commands=/usr/bin/brave-origin-stable --profile-directory=Default
X-XFCE-CommandsWithParameter=/usr/bin/brave-origin-stable --profile-directory=Default "%s" --new-window
Icon=brave-origin
Exec=/usr/bin/brave-origin-stable %U
Actions=new-private-window;

[Desktop Action new-private-window]
Name=New Private Window
Exec=/usr/bin/brave-origin-stable --incognito
